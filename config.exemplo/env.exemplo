# Credenciais da aplicação no dashboard.pluggy.ai (aba Aplicação)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Item IDs das conexões feitas pelo conector MeuPluggy (Dashboard → conexões), separados por vírgula
PLUGGY_ITEM_IDS=
# Pasta de config do Claude Code (padrão ~/.claude)
CLAUDE_CONFIG_DIR=~/.claude
# Hora da conciliação diária (0-23)
CONCILIA_HORA=20
